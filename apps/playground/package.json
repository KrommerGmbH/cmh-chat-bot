{
  "name": "@cmh/chat-playground",
  "version": "0.1.0",
  "private": true,
  "description": "Dev playground with demo data (no server needed).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
